<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <!--        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>-->
        <!--        <UseMauiEssentials>false</UseMauiEssentials>-->
        <!--        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>-->

        <Company>Silverbranch Codeworks</Company>
        <Authors>Tiabeanie Cazier</Authors>
        <Product>API Contract Utilities</Product>
        <Title>$(Company) $(Product)</Title>
        <AssemblyName>API.Utilities.Contract</AssemblyName>
        <RootNamespace>Gay.Silverbranch.$(AssemblyName)</RootNamespace>
        <PackageId>Gay.Silverbranch.pkg.$(AssemblyName)</PackageId>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>alpha-$([System.DateTime]::UtcNow.ToString("yyyyMMdd-HHmmss"))</VersionSuffix>
        <PackageProjectUrl>silverbranch-codeworks.com</PackageProjectUrl>
        <!--    <RepositoryUrl></RepositoryUrl>-->

        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(VersionPrefix).0</FileVersion>

        <PackageReleaseNotes>
            Version 1.0.0-alpha
            ----------------------------------------------------------------
            notes here
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\Icon.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>Icon.png</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>README.md</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\LICENSE.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>LICENSE.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <Content Include="..\ReleaseNotes.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>ReleaseNotes.md</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Interface\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
      <PackageReference Include="Gay.Silverbranch.pkg.API.Utilities.Common" Version="1.0.0-alpha-20250702-161018" />
      <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="8.1.1" />
    </ItemGroup>
    
</Project>
